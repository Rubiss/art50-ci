{
  "name": "art50-ci",
  "version": "0.4.0",
  "description": "Regression-test declared AI disclosures and C2PA provenance in the delivered experience.",
  "type": "module",
  "license": "MIT",
  "author": "Rubiss",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rubiss/art50-ci.git"
  },
  "homepage": "https://github.com/Rubiss/art50-ci#readme",
  "bugs": {
    "url": "https://github.com/Rubiss/art50-ci/issues"
  },
  "keywords": [
    "ai-act",
    "article-50",
    "c2pa",
    "playwright",
    "github-actions",
    "transparency",
    "transparency-regression"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "art50-ci": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "fixtures:c2pa": "node examples/c2pa-delivery/generate-fixtures.mjs",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "^0.7.0",
    "@contentauth/c2pa-types": "^0.7.2",
    "commander": "^15.0.0",
    "playwright": "^1.54.1",
    "yaml": "^2.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@contentauth/c2pa-node": {
      "unzipper": "0.12.5"
    }
  }
}
