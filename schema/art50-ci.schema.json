{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Rubiss/art50-ci/main/schema/art50-ci.schema.json",
  "title": "art50-ci configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project"],
  "anyOf": [
    {
      "required": ["surfaces"],
      "properties": {
        "surfaces": {
          "minItems": 1
        }
      }
    },
    {
      "required": ["provenance"],
      "properties": {
        "provenance": {
          "minItems": 1
        }
      }
    }
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000,
          "default": 15000
        },
        "waitUntil": {
          "enum": ["load", "domcontentloaded", "networkidle"],
          "default": "domcontentloaded"
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7680,
              "default": 1440
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4320,
              "default": 1000
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxRedirects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 5
        },
        "requestedPrivateOrigins": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "description": "Exact HTTP(S) or WebSocket origin without a path, query, fragment, wildcard, or credentials."
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "default": ".art50-ci/reports"
        },
        "screenshots": {
          "type": "boolean",
          "default": true
        },
        "redactSelectors": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "provenance": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/provenance"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "disclosures"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["website", "application", "chatbot", "generated-content", "other"],
          "default": "website"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "waitFor": {
          "type": "string",
          "minLength": 1
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7680
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4320
            }
          }
        },
        "firstInteraction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selector"],
          "properties": {
            "selector": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "enum": ["focus", "click"],
              "default": "focus"
            }
          }
        },
        "disclosures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/disclosure"
          }
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "expectedText"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "expectedText": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "enum": ["contains", "exact", "regex"],
          "default": "contains"
        },
        "caseSensitive": {
          "type": "boolean",
          "default": false
        },
        "visible": {
          "type": "boolean",
          "default": true
        },
        "inViewport": {
          "type": "boolean",
          "default": true
        },
        "unobstructed": {
          "type": "boolean",
          "default": true
        },
        "accessible": {
          "type": "boolean",
          "default": true
        },
        "accessibleName": {
          "type": "string",
          "minLength": 1
        },
        "contentSelector": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "anyOf": [
        {
          "required": ["source"]
        },
        {
          "required": ["delivered"]
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "delivered": {
          "type": "string",
          "minLength": 1
        },
        "requireManifest": {
          "type": "boolean",
          "default": true
        },
        "requireEmbedded": {
          "type": "boolean",
          "default": true
        },
        "requireSourceManifestInDeliveredChain": {
          "type": "boolean",
          "default": true
        },
        "failOnInvalid": {
          "type": "boolean",
          "default": true
        },
        "expectedDigitalSourceType": {
          "type": "string",
          "format": "uri"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824,
          "default": 52428800
        }
      }
    }
  }
}
